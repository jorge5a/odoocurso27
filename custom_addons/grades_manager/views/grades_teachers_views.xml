<odoo>
<!--   Vista Lista -->

<record id="grades_teachers_list_view" model="ir.ui.view">
  <field name="name">grades.teachers.list</field>
  <field name="model">res.partner</field>
  <field name="arch" type="xml">
    <list string="Teachers">
      <field name="name"></field>
      <field name="email"></field>
      <field name="phone"></field>
    </list>
  </field>
</record>

<!-- Vista Formulario -->
<record id="grades_teachers_form_view" model="ir.ui.view">
  <field name="name">grades.teachers.form</field>
  <field name="model">res.partner</field>
  <field name="arch" type="xml"><form string="Teacher">
      <sheet>
        <group>
          <field name="name"></field>
          <field name="email"></field>
          <field name="phone"></field>
        </group>
      </sheet>
    </form>
  </field>
</record>

<record id="grades_teachers_action" model="ir.actions.act_window">
    <field name="name">Teachers</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('is_teacher', '=', True)]</field>
    <field name="view_ids" eval="[
        (5, 0, 0),
        (0, 0, {'sequence': 1, 'view_mode': 'list', 'view_id': ref('grades_manager.grades_teachers_list_view')}),
        (0, 0, {'sequence': 2, 'view_mode': 'form', 'view_id': ref('grades_manager.grades_teachers_form_view')})
    ]"/>
</record>

</odoo>